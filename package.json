{
  "name": "eva-mode-exploration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-runtime.mjs",
    "prestart": "npm run build",
    "start": "node tools/serve.mjs dist",
    "dev": "node tools/serve.mjs dist",
    "sync": "node tools/dev-sync.mjs",
    "watch": "node tools/dev-sync.mjs --watch",
    "doctor": "node tools/doctor.mjs",
    "ports": "node tools/ports.mjs",
    "demo": "node tools/demo.mjs",
    "check:manifest": "node tools/check-manifest.mjs prototype-manifest.json",
    "check:project": "node scripts/verify-project-contract.mjs",
    "check:collaboration": "node scripts/verify-collaboration-contract.mjs",
    "release:bump": "node scripts/release-metadata.mjs",
    "comments": "node tools/comments-cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:search": "node --test tests/browser/search-controls.mjs",
    "test:task-table": "node --test tests/browser/loop-table-view.mjs tests/browser/task-filter-panel.mjs",
    "test:buttons": "node --test tests/browser/button-states.mjs tests/browser/icon-state-colors.mjs",
    "test:headings": "node --test tests/browser/heading-system.mjs",
    "test:my-ai": "node --test tests/browser/my-ai-hierarchy-unread.mjs",
    "test:my-ai-search": "node --test tests/browser/my-ai-session-search.mjs",
