    "test:mentions": "node --test tests/browser/task-comment-mentions.mjs tests/browser/im-mentions.mjs",
    "test:picker": "node --test tests/browser/member-picker-template.mjs",
    "test:select": "node --test tests/browser/select-controls.mjs",
    "test:im-performance": "node --test tests/browser/im-switch-performance.mjs tests/browser/group-member-actions.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "postcss": "8.5.6",
    "sass": "1.93.2"
  },
  "dependencies": {
