{
  "name": "eva-mode-exploration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-runtime.mjs",
    "prestart": "npm run build",
    "start": "node tools/serve.mjs dist",
    "ports": "node tools/ports.mjs",
    "demo": "node tools/demo.mjs",
    "check:manifest": "node tools/check-manifest.mjs prototype-manifest.json",
